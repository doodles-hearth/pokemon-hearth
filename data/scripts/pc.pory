script Common_EventScript_PcGuy {
	lock
	faceplayer
	if (flag(FLAG_PC_EXPLAINED)) {
		special(GetPlayerSirMissString)
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}Need me to carry some Pokémon\naround for you, {STR_VAR_1}?"
		))
	} else {
		setflag(FLAG_PC_EXPLAINED)
		special(GetPlayerSirMissString)
		message((
			"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}Hullo there, {STR_VAR_1}!\nYou're a Pokémon Wielder, right?\p"
			"Have you ever thought, “Darn, I wish I\ncould catch this seventh Pokémon,\lbut I only have room for six?”\p"
		))
		waitmessage
		waitse
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, moves(emote_happy))
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}Well, today's your lucky day,\nyessirree!\p"
			"I've been appointed to store Wielders'\nPokémon for them while they travel.\p"
			"We bring your Pokémon to a pasture\nwhere they live happily while waiting\lfor you to get them back!\p"
			"Talk to me if you ever want to send or\nretrieve your Pokémon!"
		))
	}
	closemessage

	// call(EventScript_AccessPokemonStorage)
	special(ShowPokemonStorageSystemPC)

	createfieldmugshot(VAR_0x8009, EMOTE_NORMAL)
	// Player didn't drop or retrieve mons
    if (!flag(FLAG_LAYOUT_DIFFERENT_AFTER_PC)) {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}Well… that saves me a trip!\n{FONT_SMALL}(Thank heavens!){FONT_NORMAL}"
		))
		closemessage

		// Player dropped or retrieved mons
    } else {
		special(GetPlayerSirMissString)
		if (flag(FLAG_PC_GUY_DID_TRIP)) {
			msgbox((
				"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}Pant… pant… Thanks for using our\nPokémon Pasture service, {STR_VAR_1}!"
			))
			closemessage
		} else {
			setflag(FLAG_PC_GUY_DID_TRIP)

			msgbox((
				"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}Alrighty, I'll just do a quick trip\nto the Pasture, {STR_VAR_1}!\p"
				"Just a minute!"
			))
			closemessage

			playse(SE_FLEE)
			if(var(VAR_FACING) == DIR_WEST) {
				applymovement(VAR_LAST_TALKED, moves(walk_faster_down, walk_faster_right * 4, walk_faster_down * 3))
			} else {
				applymovement(VAR_LAST_TALKED, moves(walk_faster_right * 4, walk_faster_down * 4))
			}

			waitmovementall
			waitse
			playse(SE_EXIT)
			applymovement(VAR_LAST_TALKED, moves(set_invisible))
			waitse
			waitmovementall

			delay(32)

			fadescreenswapbuffers(FADE_TO_BLACK)
			delay(120)
			fadescreenswapbuffers(FADE_FROM_BLACK)

			delay(32)

			playse(SE_EXIT)
			if(var(VAR_FACING) == DIR_WEST) {
				applymovement(VAR_LAST_TALKED, moves(face_up, set_visible, delay_16 * 3, walk_slow_up * 3, walk_slow_left * 4, walk_slow_up, face_player, delay_16 * 3))
			} else {
				applymovement(VAR_LAST_TALKED, moves(face_up, set_visible, delay_16 * 3, walk_slow_up * 4, walk_slow_left * 4, face_player, delay_16 * 3))
			}
			waitmovementall

			createfieldmugshot(VAR_0x8009, EMOTE_NORMAL)
			msgbox((
				"{CREATE_MUGSHOT MUGSHOT_VALET_POKEBALLS 0}{SPEAKER NAME_VALET}PANT…{PAUSE 8} PANT…\p"
				"Your…{PAUSE 8} pant…{PAUSE 8} Pokémon…{PAUSE 8} pant…{PAUSE 8}\nare all set!\p"
				"Whew, the pasture is a liiiittle far\nfrom here!{PAUSE 8} Pant…\p"
				"Come…{PAUSE 8} pant…{PAUSE 8} Come again!"
			))
			closemessage
		}
	}

    clearflag(FLAG_LAYOUT_DIFFERENT_AFTER_PC)
	release
	end
}

raw `EventScript_PC::
	lockall
	setvar VAR_0x8004, PC_LOCATION_OTHER
	special DoPCTurnOnEffect
	playse SE_PC_ON
	msgbox Text_BootUpPC, MSGBOX_DEFAULT
	goto EventScript_PCMainMenu
	end

EventScript_PCMainMenu::
	message gText_WhichPCShouldBeAccessed
	waitmessage
	special ScriptMenu_CreatePCMultichoice
	goto EventScript_AccessPC
	end

EventScript_AccessPC::
	switch VAR_RESULT
	case 0, EventScript_AccessPokemonStorage
	case 1, EventScript_AccessPlayersPC
	case 2, EventScript_AccessHallOfFame
	case 3, EventScript_TurnOffPC
	case MULTI_B_PRESSED, EventScript_TurnOffPC
	end

EventScript_AccessPlayersPC::
	playse SE_PC_LOGIN
	msgbox gText_AccessedPlayersPC, MSGBOX_DEFAULT
	special PlayerPC
	goto EventScript_PCMainMenu
	end

EventScript_AccessPokemonStorage::
	@ playse SE_PC_LOGIN
	@ call_if_unset FLAG_SYS_PC_LANETTE, EventScript_AccessSomeonesPC
	@ call_if_set FLAG_SYS_PC_LANETTE, EventScript_AccessLanettesPC
	@ msgbox gText_StorageSystemOpened, MSGBOX_DEFAULT
	special ShowPokemonStorageSystemPC
	@ goto EventScript_PCMainMenu
	releaseall
	end

EventScript_AccessSomeonesPC::
	msgbox gText_AccessedSomeonesPC, MSGBOX_DEFAULT
	return

EventScript_AccessLanettesPC::
	msgbox gText_AccessedLanettesPC, MSGBOX_DEFAULT
	return

EventScript_TurnOffPC::
	setvar VAR_0x8004, PC_LOCATION_OTHER
	playse SE_PC_OFF
	special DoPCTurnOffEffect
	releaseall
	end

EventScript_AccessHallOfFame::
	goto_if_unset FLAG_SYS_GAME_CLEAR, EventScript_TurnOffPC
	playse SE_PC_LOGIN
	special AccessHallOfFamePC
	goto EventScript_AccessPC
	end

EventScript_AccessPokemonBoxLink::
	playse SE_PC_LOGIN
	msgbox gText_StorageSystemOpened, MSGBOX_DEFAULT
	special ShowPokemonStorageSystemPC
	goto EventScript_TurnOffPC
	end
`
