mapscripts YifuCity_BigHouse_1F_MapScripts {
	
}

script YifuCity_BigHouse_1F_EventScript_GirlCrobatAtNight {
	lock
	faceplayer
	setspeaker(SP_NAME_GIRL)
	if (flag(FLAG_CLEARED_CROBAT_HIDEOUT)) {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_UUME_GIRL_1 0}I'm happy Yifu City is safe again!"
		))
	} else {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_UUME_GIRL_1 0}I stopped going out at night.\p"
			"Those fishy Crobat people loiter at\nthe docks right next to our building,\lspeaking in hush tones…"
		))
	}
	release
}

script YifuCity_BigHouse_1F_EventScript_Man {
	lock
	faceplayer
	setspeaker(SP_NAME_GUY)
	msgbox((
		"{CREATE_MUGSHOT MUGSHOT_UUME_FAT_GUY 0}The Guardians aren't actually\naffiliated with the Toku Council.\lThat's a common misconception!\p"
		"They're their own organization,\nwhich mostly deals in peacekeeping."
	))
	release
}

script YifuCity_BigHouse_1F_EventScript_Pokemon {
	lock
    faceplayer
	setseenmon(SPECIES_NIDORINA)
    setspeakertomonname(SPECIES_NIDORINA)
    msgbox(format(
        "Gyooh!"
    ))
    playmoncry(SPECIES_NIDORINA, CRY_MODE_NORMAL)
    waitmoncry
    release
    end
}