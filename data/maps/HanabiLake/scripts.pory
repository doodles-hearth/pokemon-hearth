const FLAG_HIDE_XIAO_HUO_LAKE = FLAG_TEMP_1

mapscripts HanabiLake_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_WAILORD_QUEST_STATE, 1: HanabiLake_EventScript_XiaoHuoRunsAway
	]
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_WAILORD_QUEST_STATE) != 1) {
            setflag(FLAG_HIDE_XIAO_HUO_LAKE)
        }
    }
}

script HanabiLake_EventScript_XiaoHuoRunsAway {
    lockall

    applymovement(LOCALID_XIAO_HUO_LAKE, moves(
        walk_fast_down * 4
    ))
    playse(SE_FLEE)
    waitmovement(0)
    removeobject(LOCALID_XIAO_HUO_LAKE)
    setflag(FLAG_HIDE_XIAO_HUO_LAKE)
    setvar(VAR_WAILORD_QUEST_STATE, 2)

    releaseall
}

script HanabiLake_EventScript_LoverBoy {
	lock
	waitse
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, moves(emote_heart))
	msgbox(
		"{CREATE_MUGSHOT MUGSHOT_HOT_BOY_1 0}{SPEAKER NAME_BOY}I'd die for you…\nI love you so so so so so much…"
	)
	closemessage
	release
}

script HanabiLake_EventScript_LoverGirl {
	lock
	waitse
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, moves(emote_heart))
	msgbox(
		"{CREATE_MUGSHOT MUGSHOT_HOT_GIRL_2 0}{SPEAKER NAME_GIRL}I wanna get married and have kids…\nEven though we met like, an hour ago…"
	)
	closemessage
	release
}
