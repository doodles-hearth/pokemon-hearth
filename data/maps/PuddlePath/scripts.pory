mapscripts PuddlePath_MapScripts {
	
}

script PuddlePath_EventScript_Farmer {
	lock
	faceplayer
	msgbox((
		"{CREATE_MUGSHOT MUGSHOT_FARMER 0}{SPEAKER NAME_FARMER}You're in what's probably the most\nfertile stretch of land in Toku.\p"
		"The forest enriches the soil, and the\nwater is rich with volcanic ashes.\p"
		"Farmers from both Soulkeep and\nHanabi City share the land."
	))
	release
}

script PuddlePath_EventScript_OneWayRoute {
	lock
	faceplayer
	msgbox((
		"{CREATE_MUGSHOT MUGSHOT_UUME_FAT_GUY 0}{SPEAKER NAME_GUY}Yeah, you can't go up this way.\nIt's a one-way down from Hanabi City!\lJust look up and enjoy the scenery!"
	))
	release
}

script PuddlePath_EventScript_OneWayWarning {
	lock
	faceplayer
	msgbox((
		"{CREATE_MUGSHOT MUGSHOT_FARMER 0}{SPEAKER NAME_FARMER}You should think twice before going\ndown this path.\p"
		"Once you're all the way down over\nthere, you can't get back up here!"
	))
	release
}

script PuddlePath_EventScript_DirectionsToBottomSign {
	msgbox((
		"{DOWN_ARROW} This way to Orchard Path"
	), MSGBOX_SIGN)
}

script PuddlePath_EventScript_Minori {
	trainerbattle_single(
		TRAINER_MINORI,
		"{CREATE_MUGSHOT MUGSHOT_FARMER 0}Damn Venonat, nibblin' on our crops!",
		"And they're not even useful in battle!",
		PuddlePath_EventScript_Minori_PostBattle
	)
	msgbox(
		"{CREATE_MUGSHOT MUGSHOT_FARMER 0}{SPEAKER NAME_FARMER}I volunteered to catch all the\nVenonat that were ruinin' our crops.\p"
		"But there are just too many!\nHave you seen the price of Poké Balls?",
		MSGBOX_AUTOCLOSE
	)
	end
}

script PuddlePath_EventScript_Minori_PostBattle {
	setnamedmon(SPECIES_VENONAT_TOKUAN)
}

script PuddlePath_EventScript_Josetsu {
	trainerbattle_single(
		TRAINER_JOSETSU,
		"{CREATE_MUGSHOT MUGSHOT_ARTIST 0}NO! I was painting the sky's reflection,\nand your ripples are RUINING it!",
		"Just… Just stop stomping your big\nfeet around!!"
	)
	msgbox(
		"{CREATE_MUGSHOT MUGSHOT_ARTIST 0}{SPEAKER NAME_ARTIST}Sigh… Plein air is tough…",
		MSGBOX_AUTOCLOSE
	)
	end
}

script PuddlePath_EventScript_Emi {
	trainerbattle_single(
		TRAINER_EMI,
		"{CREATE_MUGSHOT MUGSHOT_LASS 0}Why are you copying me?\pWhy are you repeating what I say?",
		"Fine, fine, I'll stop!"
	)
	msgbox(
		"{CREATE_MUGSHOT MUGSHOT_LASS 0}{SPEAKER NAME_LASS}My family say I'm annoying because\nI copy them all the time…",
		MSGBOX_AUTOCLOSE
	)
	end
}

script PuddlePath_EventScript_Tamiya {
	trainerbattle_single(
		TRAINER_TAMIYA,
		"{CREATE_MUGSHOT MUGSHOT_FARMER 0}Pull weeds! Protect crops!\n Catch pests! Harvest Crops!",
		"Maybe I need a break…"
	)
	msgbox(
		"{CREATE_MUGSHOT MUGSHOT_FARMER 0}{SPEAKER NAME_FARMER}I wish I could go on a nice, long,\nDRY vacation…",
		MSGBOX_AUTOCLOSE
	)
	end
}