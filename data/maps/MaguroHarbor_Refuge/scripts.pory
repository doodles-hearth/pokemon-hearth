mapscripts MaguroHarbor_Refuge_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_MAGURO_HARBOR)
	}
}

script MaguroHarbor_Refuge_EventScript_Nurse {
	createfieldmugshot(MUGSHOT_SEASIDE_NURSE)
	setvar(VAR_0x800A, LOCALID_CHANSEY_MAGURO)
	setvar(VAR_0x800B, LOCALID_NURSE_MAGURO)
	setvar(VAR_0x8009, MUGSHOT_SEASIDE_NURSE)
	call(Common_EventScript_PkmnCenterNurse_CutTheBullshit)
	waitmessage
	waitbuttonpress
	release
	end
}

script MaguroHarbor_Refuge_EventScript_Pasture {
	createfieldmugshot(MUGSHOT_SEASIDE_MAN_2)
	setvar(VAR_0x8009, MUGSHOT_SEASIDE_MAN_2)
	call(Common_EventScript_PcGuy)
	release
	end
}

script MaguroHarbor_Refuge_EventScript_Hariko {
	lock
	faceplayer
	if (flag(FLAG_BEAT_HARIKO_IN_MAGURO_REFUGE)) {
		setspeaker(SP_NAME_HARIKO)
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}Where are you headed after getting\nthe Maguro Dojo's Token?\l"
			"Silveridge?\p"
			"I heard there are enormous rock snakes\nburrowing through Silver Tunnel…\p"
			"If you see one, tell me about it the\nnext time we meet."
		))
		closemessage
	}
	elif (flag(FLAG_TALKED_TO_HARIKO_IN_MAGURO_REFUGE)) {
		setspeaker(SP_NAME_HARIKO)
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}Hello again, {PLAYER}.\nSo, do you want to battle?"
		))
		closemessage

		goto(MaguroHarbor_Refuge_BattleHariko)
	} else {
		setspeaker(SP_NAME_HARIKO)
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}Oh, hello there, {PLAYER}.\nFancy meeting you here, as they say.\p"
			"I assume you are here to challenge\nthe Maguro Harbor Dojo?\p"
			"Me? I am not particularly interested\nin becoming a great Wielder.\p"
			"I travel to learn as much as I can\nabout Pokémon!\p"
			"You've not met my companion yet, have\nyou?\lMeet my Slowpoke, Bean!"
		))
		closemessage

		setseenmon(SPECIES_SLOWPOKE)
		setnamedmon(SPECIES_SLOWPOKE)
		setflag(FLAG_TALKED_TO_HARIKO_IN_MAGURO_REFUGE)

		applymovement(LOCALID_BEAN, moves(walk_in_place_fast_left))
		waitmovement(LOCALID_BEAN)
		delay(90)
		playse(SE_LEDGE)
		applymovement(LOCALID_SLOWPOKE, moves(jump_in_place_down))
		waitmovementall
		applymovement(LOCALID_SLOWPOKE, moves(emote_question_mark))
		playmoncry(SPECIES_SLOWPOKE, CRY_MODE_NORMAL)

		msgbox("{SPEAKER NAME_BEAN}Hurr…")
		waitmovementall
		closemessage

		applymovement(LOCALID_BEAN, moves(face_down))

		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}{SPEAKER NAME_HARIKO}Bean is a little slow, but he is\nhappy to meet you!\p"
			"He may not look like a fighter, but he\nenjoys a good battle, too.\p"
			"Would you like to have a friendly bout,\nBean against your Pokémon?"
		))

		goto(MaguroHarbor_Refuge_BattleHariko)
	}
}

script MaguroHarbor_Refuge_BattleHariko {
	dynmultichoice(
		0,
		0,
		TRUE,
		10,
		0,
		DYN_MULTICHOICE_CB_NONE,
		"Yes!",
		"Maybe later."
	)

	switch(var(VAR_RESULT)) {
		case 0:
			trainerbattle_no_intro(
				TRAINER_HARIKO_MAGURO,
				format("Very interesting.")
			)

			setflag(FLAG_BEAT_HARIKO_IN_MAGURO_REFUGE)

			setspeaker(SP_NAME_HARIKO)
			msgbox((
				"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}We lost, but Bean tells me he had fun!\nI am glad.\p"
				"Everyday we learn something new about\nPokémon.\lBe it through battling or observation.\p"
				"I brought snacks for my journey.\p"
				"If I give you some, will you feel\nrewarded for this fight?"
			))
			closemessage

			giveitem(ITEM_UUMEGIRI, 4)

			setspeaker(SP_NAME_HARIKO)
			msgbox((
				"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}These can be fed to your Pokémon\nduring battle when in a pickle.\p"
				"Farewell, {PLAYER}."
			))
			closemessage
		case 1:
			setspeaker(SP_NAME_HARIKO)
			msgbox((
				"{CREATE_MUGSHOT MUGSHOT_HARIKO 0}No problem. I will be here a while\nbefore I continue my journey."
			))
			closemessage
	}

	release
}

script MaguroHarbor_Refuge_EventScript_NurseSleep {
	createfieldmugshot(MUGSHOT_SEASIDE_NURSE)
	setvar(VAR_0x8009, MUGSHOT_SEASIDE_NURSE)
	call(Common_EventScript_PkmnCenterNurse_Sleep)
	waitmessage
	waitbuttonpress
	release
	end
}

script MaguroHarbor_Refuge_EventScript_Slowpoke {
	lock
	faceplayer
	delay(90)
	setseenmon(SPECIES_SLOWPOKE)
	playmoncry(SPECIES_SLOWPOKE, CRY_MODE_NORMAL)
	if (flag(FLAG_TALKED_TO_HARIKO_IN_MAGURO_REFUGE)) {
		setspeaker(SP_NAME_BEAN)
	} else {
		setspeakertomonname(SPECIES_SLOWPOKE)
	}
	applymovement(VAR_LAST_TALKED, moves(emote_sleep))
	msgbox(format("Duh…"))
	waitmoncry
	closemessage
	release
}

script MaguroHarbor_Refuge_EventScript_DescribedMons {
	lock
	faceplayer
	if (getdescribedmon(SPECIES_KRABBY)) {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_BREEDER_F 0}{SPEAKER NAME_BREEDER}So, have you written many entries\nin your encyclopedia?"
		))
		closemessage
	} else {
		waitse
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, moves(emote_happy))
		msgboxcontig(
			"{CREATE_MUGSHOT MUGSHOT_BREEDER_F 0}{SPEAKER NAME_BREEDER}Oh! You're writing a Pokémon\nencyclopedia? That's amazing!\p"
			"I bet you're wondering how to fill up\nthe description of every Pokémon.\l"
			"Well, asking around definitely helps!"
		)
		applymovement(VAR_LAST_TALKED, moves(face_right))
		msgboxcontig(
			"For instance, Krabby sleeps burrowed\ninside holes in the sand!\p"
			"It can also grow its pincers back if\nthey ever fall of during battle."
		)
		faceplayer
		msgbox(
			"Go ahead, you can write that down\nabout it!"
		)
		closemessage
	}

	setnamedmon(SPECIES_KRABBY)
	setdescribedmon(SPECIES_KRABBY)
	release
}

script MaguroHarbor_Refuge_EventScript_Krabby {
	lock
	faceplayer
	setseenmon(SPECIES_KRABBY)
	playmoncry(SPECIES_KRABBY, CRY_MODE_NORMAL)
	setspeakertomonname(SPECIES_KRABBY)
	msgbox(format("Krblblblbl…"))
	waitmoncry
	closemessage
	release
}