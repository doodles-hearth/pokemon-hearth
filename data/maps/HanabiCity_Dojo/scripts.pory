mapscripts HanabiCity_Dojo_MapScripts {}

// TODO EVA

script HanabiCity_Dojo_EventScript_Trainer1 {
    trainerbattle_single(
		TRAINER_HANABI_GYM_1,
		format("{CREATE_MUGSHOT MUGSHOT_LASS 0}Please allow me to introduce you to\nyour own defeat!"),
		format("N-nice to meet you…"),
		BeachboundRoute_EventScript_Karu_PostBattle
	)
	setspeaker(SP_NAME_LASS)
	msgbox(("{CREATE_MUGSHOT MUGSHOT_LASS 0}You wiped me away there.\nHow long have you been a Wielder?"), MSGBOX_AUTOCLOSE)
	end
}

