const LOCALID_TAROUNTULA = 3

mapscripts YifuCity_House2_MapScripts {
	
}

script YifuCity_House2_Seamstress {
	lock
	faceplayer
	setspeaker(SP_NAME_SEAMSTRESS)
	msgboxcontig((
		"{CREATE_MUGSHOT MUGSHOT_UUME_OLD_WOMAN 0}I've been working all week on a dress\nfor the Guardian Chief's daugther.\l"
		"This will be my greatest work!"
	))

	applymovement(VAR_LAST_TALKED, Common_Movement_FaceDown)

	msgbox((
		"Tarountula, could you bring me some\nmore of that red thread?"
	))
	closemessage

	playmoncry(SPECIES_TAROUNTULA, CRY_MODE_NORMAL)
	applymovement(LOCALID_TAROUNTULA, moves(jump_in_place_right, walk_right * 2, walk_up, walk_right * 2, face_up, delay_16))
	waitmovement(0)
	playse(SE_LEDGE)
	applymovement(LOCALID_TAROUNTULA, moves(jump_in_place_up, delay_16, walk_left * 2, walk_down, walk_left * 2))
	waitmovement(0)

	setnamedmon(SPECIES_TAROUNTULA)

	release
}

script YifuCity_House2_Model {
	lock
	faceplayer
	
	if(flag(FLAG_OBTAINED_CHOICE_SCARF)) {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_MASQUERAIN_GIRL 0}That Tarountula creeps me out…\nIt has so many legs…"
		))
		closemessage
		setnamedmon(SPECIES_TAROUNTULA)
	} else {
		waitse
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, moves(emote_sad))
		setspeaker(SP_NAME_MODEL)
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_MASQUERAIN_GIRL 0}Yawn… Being a model is so tiring!\nMy feet hurt from standing for hours…\p"
			"I do get some sweet free stuff\nthough!\p"
			"Here, you can have this, I already\nhave this color!"
		))
		closemessage

		giveitem(ITEM_CHOICE_SCARF)
		setflag(FLAG_OBTAINED_CHOICE_SCARF)
	}
	
	release
}

script YifuCity_House2_Tarountula {
	lock
	faceplayer
	setseenmon(SPECIES_TAROUNTULA)
	playmoncry(SPECIES_TAROUNTULA, CRY_MODE_NORMAL)
	setspeakertomonname(SPECIES_TAROUNTULA)
	msgbox(("Thshh!"))
	waitmoncry
	closemessage

	if (!flag(FLAG_OBTAINED_DESTINY_KNOT)) {
		playse(SE_LEDGE)
		applymovement(LOCALID_TAROUNTULA, moves(lock_facing_direction, jump_in_place_down, unlock_facing_direction))
		waitmovement(0)

		giveitem(ITEM_DESTINY_KNOT)
		setflag(FLAG_OBTAINED_DESTINY_KNOT)
	}
	release
}