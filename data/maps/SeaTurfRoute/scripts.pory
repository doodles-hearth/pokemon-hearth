const FLAG_HIDE_XIAO_HUO_SEATURF = FLAG_TEMP_1
const FLAG_HIDE_CROBATS_AND_CO = FLAG_TEMP_2
const FLAG_ACCESS_WAILORD = FLAG_TEMP_3
const FLAG_HIDE_XIAO_HUO_MOM = FLAG_TEMP_4

mapscripts SeaTurfRoute_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_WAILORD_QUEST_STATE) != 3) {
            setflag(FLAG_HIDE_XIAO_HUO_SEATURF)
        }
        if (var(VAR_WAILORD_QUEST_STATE) >= 3) {
            setflag(FLAG_ACCESS_WAILORD)
        }
        if (var(VAR_WAILORD_QUEST_STATE) != 6) {
            setflag(FLAG_HIDE_CROBATS_AND_CO)
        }
        if (var(VAR_WAILORD_QUEST_STATE) == 8) {
            setflag(FLAG_HIDE_XIAO_HUO_MOM)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_WAILORD_QUEST_STATE, 6: SeaTurfRoute_EventScript_EscapingWailord
    ]
}

script SeaTurfRoute_EventScript_Wailord {
    lock
    msgbox(
        "It's an enormous marine Pokémon!"
    )
    setseenmon(SPECIES_WAILORD)
    closemessage

    delay(32)

    playmoncry(SPECIES_WAILORD, CRY_MODE_WEAK)
	setvar(VAR_0x8004, 0)  // vertical pan
	setvar(VAR_0x8005, 2)  // horizontal pan
	setvar(VAR_0x8006, 20) // num shakes
	setvar(VAR_0x8007, 2)  // shake delay
	special(ShakeCamera)
    waitstate
    waitmoncry

    delay(32)

    msgbox(
        "It somehow looks in pain."
    )
    closemessage

    release
}

script SeaTurfRoute_EventScript_EscapingWailord {
    lockall
    setvar(VAR_WAILORD_QUEST_STATE, 7)

    destroyfollowernpc
    
    delay(48)

    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(face_up))
    applymovement(LOCALID_XIAO_HUO_SEATURF_2, moves(face_down, emote_happy))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Whew! Everyone okay?"
    )
    waitmovementall

    waitse
    playse(SE_PIN)
    applymovement(LOCALID_SEATURF_BOSS, moves(emote_angry))
    applymovement(LOCALID_PLAYER, moves(face_right))
    message(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}Yeah, yeah, whatever. We were jus'\n'bout to find the exit ourselves!"
    )
    waitmovementall
    waitmessage
    waitbuttonpress
    applymovement(LOCALID_SEATURF_BOSS, moves(walk_in_place_fast_right))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}Y'all scram back home ahead of me.\nI'll catch up."
    )

    applymovement(LOCALID_SEATURF_ADMIN, moves(walk_in_place_fast_down))
    applymovement(LOCALID_SEATURF_GRUNT_2, moves(face_up))
    applymovement(LOCALID_SEATURF_KEVIN, moves(face_right))

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_GOLBAT_F 0}{SPEAKER NAME_GOLBAT_ADMIN}Yessir!\nZubat… ALIGN!"
    )
    closemessage

    delay(24)

    applymovement(LOCALID_SEATURF_GRUNT_2, moves(face_down))
    applymovement(LOCALID_SEATURF_GRUNT_1, moves(walk_fast_right * 2, walk_up, face_down))
    applymovement(LOCALID_SEATURF_KEVIN, moves(
        walk_faster_right,
        lock_facing_direction,
        lock_anim,
        jump_left,
        unlock_facing_direction,
        unlock_anim,
        delay_8,
        walk_fast_up,
        walk_fast_right * 2,
        walk_fast_down,
        walk_fast_right,
        walk_fast_down
    ))
    delay(8)
    playse(SE_M_COMET_PUNCH)
    waitmovementall

    applymovement(LOCALID_SEATURF_GRUNT_1, moves(zubats_align))
    applymovement(LOCALID_SEATURF_GRUNT_2, moves(zubats_align))
    applymovement(LOCALID_SEATURF_KEVIN, moves(zubats_align))
    waitmovementall

    playse(SE_M_DIVE)
	fadescreenswapbuffers(FADE_TO_WHITE)
    removeobject(LOCALID_SEATURF_GRUNT_1)
	removeobject(LOCALID_SEATURF_GRUNT_2)
	removeobject(LOCALID_SEATURF_KEVIN)
	removeobject(LOCALID_SEATURF_ADMIN)
	delay(80)
	fadescreenswapbuffers(FADE_FROM_WHITE)

    delay(48)

    applymovement(LOCALID_SEATURF_BOSS, moves(walk_in_place_fast_left))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}Listen, uh…\p"
        "Thanks, I guess.{PAUSE 16}\nFer the help 'n all.\p"
        "{FONT_SMALL}Jus' don't tell anyone the Crobat Shadows\nwere rescued by a buncha kids…{FONT_NORMAL}"
    )
    closemessage

    applymovement(LOCALID_SEATURF_BOSS, moves(crobat_cape))
    waitmovementall
    playse(SE_M_DIVE)
	fadescreenswapbuffers(FADE_TO_WHITE)
	removeobject(LOCALID_SEATURF_BOSS)
	delay(80)
	fadescreenswapbuffers(FADE_FROM_WHITE)

    delay(48)

    applymovement(LOCALID_PLAYER, moves(face_up))
    applymovement(LOCALID_XIAO_HUO_SEATURF_2, moves(walk_in_place_fast_down))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}So those were the infamous Crobat\nShadows, huh?\p"
        "They looked like a bunch of scared\nchildren! Haha!"
    )
    waitmovementall
    closemessage

    delay(48)

    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_SEATURF_2, moves(emote_exclamation_mark, delay_16 * 6))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}…Oh, I was just about forgetting\nsomething!\lHere, you earned it!"
    )
    waitse
    waitmovementall
    closemessage

    delay(32)

    message(format(
		"{PLAYER} received the Folded Token\n"
		"from Xiao Huo."
	))
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Aaand you can have this cool Scroll\nfor a festive Pokémon move!"
    )
    closemessage

    // TODO EVA
    // giveitem(ITEM_TM_FIRE_PUNCH)

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}This turned into a whole thing, huh?\p"
        "I'm going back home.\nTalk to my mom before going!\lShe'll give you a little something too!"
    )
    closemessage

    delay(32)

    playse(SE_LEDGE)
    applymovement(LOCALID_SEATURF_DRAMPA, moves(
        face_left
        delay_16 * 3
        walk_fast_right * 3
        walk_fast_down * 2
        walk_fast_left * 4
        walk_fast_up * 3
        walk_fast_right * 2
        walk_faster_right * 12
    ))
    applymovement(LOCALID_XIAO_HUO_SEATURF_2, moves(
        jump_left
        delay_16 * 2
        walk_fast_right * 3
        walk_fast_down * 2
        walk_fast_left * 4
        walk_fast_up * 3
        walk_fast_right * 2
        walk_faster_right * 12
    ))
    delay(80)
    playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
    waitmovementall

    delay(48)

    setflag(FLAG_BADGE04_GET)
    setmemoryall(MEMORY_BEAT_DOJO)
	setvar(VAR_0x8008, 4)
	call(Common_EventScript_SetGymTrainers)
	addvar(VAR_PLAYER_REPUTATION, 5)
    
    setflag(FLAG_HIDE_CROBATS_AND_CO)
    warpsilent(MAP_SEA_TURF_ROUTE, WARP_ID_AFTER_WAILORD)

    releaseall
}

script SeaTurfRoute_EventScript_ChasingXiaoHuo_Left {
    lockall

    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(
        walk_down,
        face_left,
        emote_exclamation_mark,
        delay_16 * 6,
        walk_down * 2,
        walk_left * 10
    ))
    waitmovementall

    goto(SeaTurfRoute_EventScript_ChasingXiaoHuo_Part2)
}

script SeaTurfRoute_EventScript_ChasingXiaoHuo_Right {
    lockall

    applymovement(LOCALID_PLAYER, moves(
        walk_down,
        face_left,
        emote_exclamation_mark,
        delay_16 * 6,
        walk_down * 2,
        walk_left * 11
    ))
    delay(16)
    playse(SE_PIN)

    waitmovementall

    goto(SeaTurfRoute_EventScript_ChasingXiaoHuo_Part2)
}

script SeaTurfRoute_EventScript_ChasingXiaoHuo_Part2 {
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(
        walk_slow_left * 3
    ))
    waitmovementall

    playse(SE_LEDGE)
    applymovement(LOCALID_XIAO_HUO_SEATURF, moves(jump_in_place_right))
    waitmovementall

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Heh, how are you gonna catch me now?"
    )
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(emote_upset))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}Xiao Huo! Come down!\nYou'll fall and hurt yourself!"
    )
    waitse
    waitmovementall
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_SEATURF, moves(emote_angry))

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}You can't tell me what to do, mom!"
    )
    waitse
    waitmovementall
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(emote_angry))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}Don't make me come up there…"
    )
    waitse
    waitmovementall
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_SEATURF, moves(emote_exclamation_mark, delay_16))
    waitse
    waitmovementall

    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(walk_left))
    delay(10)

    playse(SE_LEDGE)
    applymovement(LOCALID_XIAO_HUO_SEATURF, moves(
        disable_jump_landing_ground_effect,
        lock_facing_direction,
        jump_left,
        unlock_facing_direction,
        enable_jump_landing_ground_effect,
        walk_in_place_faster_right * 2
    ))
    waitmovementall
    setflag(FLAG_HIDE_XIAO_HUO_SEATURF)
    removeobject(LOCALID_XIAO_HUO_SEATURF)

    playse(SE_FALL)
    message(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}AAAaaaa{FONT_SMALL}aaaahhh…"
    )
    waitse
    waitmessage

    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark))
    delay(8)
    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(emote_exclamation_mark))
    waitse

    waitbuttonpress
    closemessage

    waitmovementall

    delay(48)

    playse(SE_PIN)
    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(emote_sad, delay_16 * 6))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}Oh gosh, he fell in!\nOh no! It's my fault!\l"
        "Oh gosh, what if it digests him?!"
    )
    waitmovementall

    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(walk_in_place_fast_down))
    applymovement(LOCALID_PLAYER, moves(face_up))

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}I'm claustrophobic!\nI cannot go in there!\pPlease, please help, young Wielder!"
    )
    closemessage

    applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(face_left))
    applymovement(LOCALID_PLAYER, moves(face_left))

    playmoncry(SPECIES_WAILORD, CRY_MODE_WEAK)
	setvar(VAR_0x8004, 0)  // vertical pan
	setvar(VAR_0x8005, 2)  // horizontal pan
	setvar(VAR_0x8006, 20) // num shakes
	setvar(VAR_0x8007, 2)  // shake delay
	special(ShakeCamera)
    waitstate
    waitmoncry

    applymovement(LOCALID_CAMERA, moves(walk_slow_right * 3))
    waitmovementall
    special(RemoveCameraObject)

    setseenmon(SPECIES_WAILORD)
    setvar(VAR_WAILORD_QUEST_STATE, 4)

    releaseall
}

script SeaTurfRoute_EventScript_XiaoHuoMom {
    lock
    faceplayer

    # TODO EVA dialogue
    if (var(VAR_WAILORD_QUEST_STATE) == 7) {
        if (checkitem(ITEM_SECRET_SURF)) {
            msgbox(
                "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}Thanks again!"
            )
            closemessage    
        } else {
            msgbox(
                "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}Thank you so much for helping\nXiao Huo. What a relief!\p"
                "Huh? He said I'd give you a reward?\nHuff… That child drives me nuts!\p"
                "Alright, let me think…"
            )
            closemessage

            playse(SE_PIN)
            applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(emote_exclamation_mark, delay_16 * 6))
            waitse
            waitmovementall

            msgbox(
                "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}You came here on foot, didn't you?\p"
                "What if I told you you could continue\nyour adventure sailing the oceans?"
            )
            closemessage

            giveitem(ITEM_SECRET_SURF)

			msgbox(
                "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}This is a very old technique,\ncreated by the first Wielders.\p"
				"It lets you ride your Pokémon on water\nusing an array of moves.\lLike this one!"
			)
			closemessage

			giveitem(ITEM_TM_SPLASH)

            msgbox(
                "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}I hope this will be useful to you.\p"
                "On behalf of Xiao Huo and Wailord…\nThank you!"
			)
			closemessage

            if (var(VAR_FACING) == DIR_WEST) {
                applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(walk_up, walk_right * 10))
            } else {
                applymovement(LOCALID_XIAO_HUO_MOM_SEATURF, moves(walk_right * 9))
            }
            waitmovementall
            removeobject(LOCALID_XIAO_HUO_MOM_SEATURF)
            setflag(FLAG_HIDE_XIAO_HUO_MOM)
            setvar(VAR_WAILORD_QUEST_STATE, 8)
        }
    } else {
        waitse
        playse(SE_PIN)
        applymovement(VAR_LAST_TALKED, moves(emote_sad, delay_16 * 6))
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_WOMAN_2 0}{SPEAKER NAME_WOMAN}Please, help Xiao Huo!\nHe's such a reckless child!"
        )
        waitmessage
        closemessage

        applymovement(VAR_LAST_TALKED, moves(walk_in_place_fast_left))
        waitmovement(VAR_LAST_TALKED)
    }

    releaseall
}

script SeaTurfRoute_EventScript_FallDownHole {
    lockall
    delay(48)
    playse(SE_FALL)
    applymovement(LOCALID_PLAYER, moves(set_invisible))
    waitse
    warpfall(MAP_INSIDE_WAILORD, WARP_ID_EXIT_WAILORD)
    releaseall
}

script SeaTurfRoute_EventScript_Toyo {
    trainerbattle_single(
		TRAINER_TOYO,
		"{CREATE_MUGSHOT MUGSHOT_COOK 0}No! Don't bite me!\nI have no food!",
		"Sorry darling, I'm a little jittery!"
	)
	msgbox(
        "{CREATE_MUGSHOT MUGSHOT_COOK 0}{SPEAKER NAME_COOK}Cooking for the festival is\n"
        "stressful! People are vo-{PAUSE 8}ra-{PAUSE 8}cious!",
        MSGBOX_AUTOCLOSE
    )
	end
}

script SeaTurfRoute_EventScript_Taro {
    trainerbattle_single(
		TRAINER_TARO,
		"{CREATE_MUGSHOT MUGSHOT_FISHERMAN 0}Piss off.\nThis is my fishing spot.",
		"Gee, alright, we can share!"
	)
	msgbox(("{CREATE_MUGSHOT MUGSHOT_FISHERMAN 0}{SPEAKER NAME_FISHERMAN}This pool's too far down for me to\ncast my line anyway…"), MSGBOX_AUTOCLOSE)
	end
}

script SeaTurfRoute_EventScript_YangBo {
	trainerbattle_double(
		TRAINER_YANG_BO,
		"{SPEAKER NAME_TWIN_YANG}Our ma sends us off to the coast for\nfish and seashells everyday.\p"
        "{SPEAKER NAME_TWIN_BO}Our legs are super strong, and so are\nour Pokémon!",
		"Aw man, you smoked last week's catch!",
		"{SPEAKER NAME_TWIN_YANG}If you wanna battle…\p"
        "{SPEAKER NAME_TWIN_BO}…You'll need at\nleast two Pokémon!"
	)
	msgbox(
        "{SPEAKER NAME_TWIN_YANG}It's not always easy, you know?\p"
        "{SPEAKER NAME_TWIN_BO}Sometimes we fight Wattrel that try\nto steal our seashells!",
        MSGBOX_AUTOCLOSE
    )
	end
}

script SeaTurfRoute_EventScript_Keita {
    trainerbattle_single(
		TRAINER_KEITA,
		"Huff… This route is more tiring than\nI'd anticipated…",
		"At least I got to rest a little!"
	)
	msgbox(
        "{SPEAKER NAME_TRAVELER}How do you just spring up and down\nwithout looking tired?\p"
        "Ah, to be young again!",
        MSGBOX_AUTOCLOSE
    )
	end
}

script SeaTurfRoute_EventScript_Yang {
    lock
    
    msgbox(
        "{SPEAKER NAME_LITTLE_GIRL}Darnit… Can't find any Krabby today…"
    )
    closemessage

    release
}

script SeaTurfRoute_EventScript_Bo {
    lock

    faceplayer
    
    msgbox(
        "{SPEAKER NAME_LITTLE_BOY}We're catching fish and seashells\nfor our ma!"
    )
    closemessage

    release
}