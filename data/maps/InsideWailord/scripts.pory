const FLAG_LEFT_TRIGGER = FLAG_TEMP_1

mapscripts InsideWailord_MapScripts {}

script InsideWailord_EventScript_XiaoHuo {
    lock
    faceplayer

    if (var(VAR_WAILORD_QUEST_STATE) == 5) {
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Oh good, you're back!\n"
            "Let's explore further back!"
        )
        closemessage
    } else {
        setvar(VAR_WAILORD_QUEST_STATE, 5)

        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Ha! You fell down here too!\p"
            "Good thing you followed me, actually.\nWailord looks unwell.\l"
            "I'm sure it ate something bad!\p"
            "Let's see if we can find what's\nbothering Wailord, {PLAYER}.\p"
            "I'm right behind you!"
        )
        closemessage
        setnamedmon(SPECIES_WAILORD)
    }

    setfollowernpc(LOCALID_WAIL_XIAO_HUO, FNPC_WHITE_OUT, InsideWailord_EventScript_FollowerXiaoHuo, battlePartner=0)

    release
}

script InsideWailord_EventScript_FollowerXiaoHuo {
    lock
    faceplayer
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}C'mon, let's explore further back!\p"
        "Huh? You have something you need to\ndo outside first?"
    )

    mcdialogueB(
        "I'll be right back.",
        "Let's keep exploring!"
    )
    closemessage

    if (var(VAR_RESULT) == 0) {
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Okay, Drampa will carry you out.\n"
            "Come back quickly though!"
        )
        closemessage
        setnamedmon(SPECIES_DRAMPA)
        playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
        warpteleport(MAP_SEA_TURF_ROUTE, WARP_ID_ENTER_WAILORD)
    } else {
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Let's not lose any more time!"
        )
        closemessage
    }

    release
}

script InsideWailord_EventScript_NeedSurf_Left {
    setflag(FLAG_LEFT_TRIGGER)
    goto(InsideWailord_EventScript_NeedSurf)
}

script InsideWailord_EventScript_NeedSurf {
    lockall
    facefollowernpc

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}I bet you're thinking “Oh man, I\ncan't swim!”\p"
        "Don't you worry, {PLAYER}!\nMy Drampa can carry us across!"
    )
    closemessage

    if (flag(FLAG_LEFT_TRIGGER)) {
        applymovement(LOCALID_PLAYER, moves(face_left, lock_facing_direction, walk_right, unlock_facing_direction))
        applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_up))
    } else {
        applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_left, walk_up))
        applymovement(LOCALID_PLAYER, moves(delay_16, face_left))
    }

    waitmovementall

    delay(24)

    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Drampa, use Aqua Jet!"
    )
    closemessage
    setnamedmon(SPECIES_DRAMPA)

    playse(SE_BALL_OPEN)
    applymovement(LOCALID_WAIL_DRAMPA, moves(exit_pokeball, face_up))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitse
    waitmovement(LOCALID_WAIL_DRAMPA)

    playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
    applymovement(LOCALID_WAIL_DRAMPA, moves(shake_horizontal))
    waitmovementall

    delay(24)

    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_up, set_invisible))
    applymovement(LOCALID_PLAYER, moves(delay_16, walk_left, walk_up, set_invisible))
    waitmovementall

    applymovement(LOCALID_WAIL_DRAMPA, InsideWailord_Movement_SurfWithDrampa)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, InsideWailord_Movement_SurfWithDrampa)
    applymovement(LOCALID_PLAYER, InsideWailord_Movement_SurfWithDrampa)
    waitmovementall
    
    applymovement(LOCALID_PLAYER, moves(set_visible, walk_up, walk_right, face_left))
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(delay_16, set_visible, walk_up, face_down))
    waitmovementall
    playse(SE_BALL_OPEN)
    applymovement(LOCALID_WAIL_DRAMPA, moves(enter_pokeball))
    waitse
    waitmovementall
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(face_up, delay_8, emote_exclamation_mark, delay_16 * 6))
    applymovement(LOCALID_PLAYER, moves(delay_8, face_up))
    delay(8)
    playse(SE_PIN)
    waitse
    waitmovementall

    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_slow_up * 1))

	playbgm(MUS_ENCOUNTER_AQUA, TRUE)

    delay(16)
    playse(SE_PIN)
    applymovement(LOCALID_WAIL_BOSS, moves(emote_angry))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}This place smells like a Slaking's\nbutt!\p"
        "I can't believe we're stuck in 'ere\nlike a buncha morons!"
    )
    setnamedmon(SPECIES_SLAKING)
    applymovement(LOCALID_WAIL_ADMIN, moves(walk_in_place_fast_up))
    msgboxcontig(
        "{SPEAKER NAME_GOLBAT_ADMIN}I can't believe this thing ate our\nraft…"
    )
    applymovement(LOCALID_WAIL_GRUNT2, moves(walk_in_place_fast_left))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_ZUBAT 0}{SPEAKER NAME_ZUBAT_GRUNT}I can't believe we let KEVIN be the\nlookout!"
    )
    applymovement(LOCALID_WAIL_KEVIN, moves(shake_horizontal))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_ZUBAT 0}{SPEAKER NAME_KEVIN}Ah, I'm sorry, guys…"
    )
    closemessage

    delay(32)
    playse(SE_PIN)
    applymovement(LOCALID_WAIL_BOSS, moves(emote_exclamation_mark, delay_16 * 6))
    waitse
    waitmovementall
    applymovement(LOCALID_WAIL_GRUNT2, moves(face_down))
    applymovement(LOCALID_WAIL_ADMIN, moves(delay_16, face_down))
    applymovement(LOCALID_WAIL_KEVIN, moves(delay_16, face_down))

    waitmovementall

    delay(32)

    playse(SE_LEDGE)
    applymovement(LOCALID_WAIL_ADMIN, moves(jump_in_place_down))
    waitmovementall
    msgboxcontig(
        "{SPEAKER NAME_GOLBAT_ADMIN}Oh goshawott boss, it's the kid that\nblew up our ol' hideout in Yifu City!"
    )

    waitse
    playse(SE_PIN)
    applymovement(LOCALID_WAIL_BOSS, moves(emote_angry, delay_16 * 6))
    applymovement(LOCALID_WAIL_ADMIN, moves(delay_16 * 2, walk_right, face_down))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}Ugh, I can't deal with this kid\nagain!\p"
        "How the heck did yer dummasses end up\ninside a Wailord?"
    )
    waitmovementall

    waitse
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(emote_pensive))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}…You guys are also inside a\nWailord."
    )

    applymovement(LOCALID_WAIL_GRUNT2, moves(walk_in_place_fast_down))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_ZUBAT 0}{SPEAKER NAME_ZUBAT_GRUNT}Wait, who's the sassy midget?"
    )

    waitse
    playse(SE_LEDGE)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(jump_in_place_up))
    waitse
    waitmovementall
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(emote_angry, delay_16 * 6))
    msgboxcontig(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}HEY! I'm not a midget!\nI'm a Dojo Master!!\p"
        "You lot are upsetting Wailord's\nstomach!\p"
        "Get out of here! Uh, it's an order!"
    )
    waitmovementall

    waitse
    playse(SE_PIN)
    applymovement(LOCALID_WAIL_BOSS, moves(emote_angry, delay_16 * 6))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}Nobody orders the Crobat Shadows\n'round!\p"
        "That's it, I'm shutting ya brats down!"
    )
    waitmovementall
    closemessage

    applymovement(LOCALID_WAIL_BOSS, moves(walk_down * 2))
    delay(16)
    applymovement(LOCALID_WAIL_KEVIN, moves(walk_in_place_fast_right))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_ZUBAT 0}{SPEAKER NAME_KEVIN}Boss, maybe they could help us git\noutta here, actually?"
    )
    closemessage
    waitmovementall
    delay(32)
    applymovement(LOCALID_WAIL_BOSS, moves(walk_in_place_fast_up))
    applymovement(LOCALID_WAIL_KEVIN, moves(face_down))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}Help us?!\nWe ain't lost, dummy!\lI got everythin' under control!"
    )
    closemessage
    applymovement(LOCALID_WAIL_BOSS, moves(walk_down))
    applymovement(LOCALID_WAIL_ADMIN, moves(delay_16, walk_down))
    waitmovementall

    waitse
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(emote_sweat, delay_16 * 6))
    msgbox(
        "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}But wait, we're not here to-"
    )
    waitmovementall
    closemessage

    multi_2_vs_2(
        TRAINER_WAIL_CROBAT_BOSS,
        format("Yer stronger than I thought…"),
        TRAINER_WAIL_GOLBAT_ADMIN,
        format("Boss, forgive me!"),
        PARTNER_XIAO_HUO
    )

    if (var(VAR_RESULT) == 1) {
        delay(48)

        playse(SE_PIN)
        applymovement(LOCALID_WAIL_BOSS, moves(emote_pensive))
        msgboxcontig(
            "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}… … … … … …\p"
            "I only fought with one of my Pokémon…\nStill, I may've underestimated ya."
        )

        waitse
        playse(SE_PIN)
        applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(emote_angry, delay_16 * 6))
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Are you done? Can we all calm down\nand listen to each other now?"
        )
        closemessage

        delay(48)

        applymovement(LOCALID_WAIL_BOSS, moves(walk_in_place_fast_down))
        msgboxcontig(
            "{CREATE_MUGSHOT MUGSHOT_CROBAT 0}{SPEAKER NAME_CROBAT_BOSS}I guess we came off a lil' strong."
        )

        applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_in_place_fast_up))
        msgboxcontig(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}We get it, you're trapped in here.\nYou're also making Wailord ill!\p"
            "My Drampa can get you all out of here\nsafely!"
        )

        waitse
        playse(SE_PIN)
        applymovement(LOCALID_WAIL_GRUNT1, moves(emote_pensive))
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_ZUBAT 0}{SPEAKER NAME_ZUBAT_GRUNT}That does sound pretty alright."
        )
        closemessage

        applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_in_place_fast_down))
        playse(SE_BALL_OPEN)
        applymovement(LOCALID_WAIL_DRAMPA, moves(face_right, exit_pokeball))
        waitmovementall
        msgbox(
            "{CREATE_MUGSHOT MUGSHOT_HOT_LITTLE_BOY 0}{SPEAKER NAME_XIAO_HUO}Let's go, Drampa!\nGive it your all!"
        )
        closemessage
        
        applymovement(LOCALID_WAIL_GRUNT2, moves(walk_down))
        applymovement(LOCALID_WAIL_GRUNT1, moves(delay_8, walk_down))
        applymovement(LOCALID_WAIL_KEVIN, moves(delay_16, walk_down * 3))
        delay(16)
        playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
        applymovement(LOCALID_WAIL_DRAMPA, moves(shake_horizontal))

        waitmovementall

        setmemoryall(MEMORY_INSIDE_WAILORD)
        setvar(VAR_WAILORD_QUEST_STATE, 6)
        warp(MAP_SEA_TURF_ROUTE, WARP_ID_ENTER_WAILORD)
    } else {
        fadescreenswapbuffers(FADE_TO_BLACK)
        special(HealPlayerParty)
        warpsilent(MAP_SEA_TURF_ROUTE, WARP_ID_ENTER_WAILORD)
    }
    
    releaseall
}

movement InsideWailord_Movement_SurfWithDrampa {
    walk_up * 3
    walk_left * 2
    walk_up
    walk_slow_up * 2
}