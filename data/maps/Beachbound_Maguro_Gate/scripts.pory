mapscripts Beachbound_Maguro_Gate_MapScripts {
	
	MAP_SCRIPT_ON_TRANSITION {
		if (var(VAR_DECAY_BEACHBOUND_ROUTE) > 0 && !flag(FLAG_CURED_DECAY_HARVEST_SHRINE)) {
			setdynamicwarp(MAP_BEACHBOUND_ROUTE_DECAY, 0)
		} else {
			setdynamicwarp(MAP_BEACHBOUND_ROUTE, 0)
		}
	}	
}

script Beachbound_Maguro_Gate_EventScript_Guard {
	lock
	if (var(VAR_DECAY_BEACHBOUND_ROUTE) == 1) {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_SAMURAI 0}{SPEAKER NAME_GUARDIAN}Are you going to Beachbound Route?\nUh, be careful, kid!"
		))
	} else {
		msgbox((
			"{CREATE_MUGSHOT MUGSHOT_SAMURAI 0}{SPEAKER NAME_GUARDIAN}Ugh, I hate guard duty…\nWe're not even allowed a book…"
		))
	}
	closemessage
	release
}

script Beachbound_Maguro_Gate_EventScript_Umbreon {
	lock
    faceplayer
	setseenmon(SPECIES_UMBREON)
	setspeakertomonname(SPECIES_UMBREON)
	playmoncry(SPECIES_UMBREON, CRY_MODE_NORMAL)
    msgbox((
        "Whew…"
    ))
    waitmoncry
    release
    end
}